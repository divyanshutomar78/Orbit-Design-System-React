{
  "name": "orbit-design-system",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w orbit-ds-components",
    "publish:components": "npm run build -w orbit-ds-components && npm publish -w orbit-ds-components --access public",
    "storybook": "npm run dev -w @orbit/storybook",
    "build:storybook": "npm run build -w @orbit/storybook",
    "fifa-match-stats": "npm run dev -w @orbit/fifa-match-stats",
    "car-loan-emi": "npm run dev -w @orbit/car-loan-emi-calculator",
    "send-custom-answer": "npm run dev -w @orbit/send-custom-answer-modal",
    "flight-info": "npm run dev -w @orbit/flight-info-panel",
    "billing": "npm run dev -w @orbit/billing-invoices",
    "attendance": "npm run dev -w @orbit/student-attendance",
    "send-message": "npm run dev -w @orbit/send-message-email-modal",
    "ev-breakeven": "npm run dev -w @orbit/ev-petrol-breakeven",
    "maintenance-training": "npm run dev -w @orbit/maintenance-training-form",
    "add-user-flow": "npm run dev -w @orbit/add-user-flow",
    "car-affordability": "npm run dev -w @orbit/car-affordability-planner",
    "spaces-modal": "npm run dev -w @orbit/spaces-modal",
    "mission-watch": "npm run dev -w @orbit/mission-watch-poc",
    "verify:tokens": "node scripts/verify-token-usage.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "orbit-ds-variables": "^1.0.4"
  }
}
