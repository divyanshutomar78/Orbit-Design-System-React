{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist",
  "lib": {
    "entryFile": "src/index.ts",
    "cssUrl": "inline"
  },
  "assets": [
    {
      "glob": "styles.css",
      "input": "src",
      "output": "."
    },
    {
      "glob": "**/*.css",
      "input": "src/components",
      "output": "./components"
    }
  ]
}
